<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Pão & Música</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg">

            <div class="container">

                <a class="navbar-brand" asp-controller="Musicas" asp-action="Index">
                    Pão & Música
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Musicas"
                               asp-action="Index">
                                🎵 Músicas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Musicas"
                               asp-action="Hoje">
                                🥐 Músicas de Hoje
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Musicas"
                               asp-action="Create">
                                🍞 Sugerir Música
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="footer py-4">

        <div class="container text-center">

            <strong>🍞 Pão & Música</strong>

            <br />

            <small>
                Um lugar onde música e pão combinam perfeitamente 🎵🥖
            </small>

            <br />

            <small>
                &copy; @DateTime.Now.Year - Sistema de Músicas
            </small>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>