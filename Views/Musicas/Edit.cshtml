@model SistemaMusicas.Models.Musica

@{
    ViewData["Title"] = "Editar Música";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4 p-4" style="background-color: #fff8f0;">
            <div class="text-center mb-4">
                <h1 class="display-6 fw-bold text-dark">✏️ Editar Música</h1>
                <p class="text-muted">Atualize as informações do pedido</p>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataCadastro" />

                <div class="mb-3">
                    <label asp-for="NomeAluno" class="form-label fw-bold">Nome do Aluno</label>
                    <input asp-for="NomeAluno" class="form-control rounded-3" required />
                </div>

                <div class="mb-3">
                    <label asp-for="NomeMusica" class="form-label fw-bold">Música</label>
                    <input asp-for="NomeMusica" class="form-control rounded-3" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Autor" class="form-label fw-bold">Autor / Artista</label>
                    <input asp-for="Autor" class="form-control rounded-3" />
                </div>

                <div class="mb-4">
                    <label asp-for="LinkYoutube" class="form-label fw-bold">Link do YouTube</label>
                    <input asp-for="LinkYoutube" class="form-control rounded-3" />
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">Cancelar</a>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 text-white">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>